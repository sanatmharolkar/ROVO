    <owl:Class rdf:about="https://w3id.org/rdonto/op#Request"/>
    


    <!-- https://w3id.org/rdonto/op#RequestReason -->


    <owl:Class rdf:about="https://w3id.org/rdonto/op#RequestReason"/>
    


    <!-- https://w3id.org/rdonto/op#RequestType -->


    <owl:Class rdf:about="https://w3id.org/rdonto/op#RequestType"/>
    


