    <owl:Class rdf:about="https://w3id.org/rdonto/op#SAEvidence"/>
    


    <!-- https://w3id.org/rdonto/op#SARequirement -->


    <owl:Class rdf:about="https://w3id.org/rdonto/op#SARequirement"/>
    


