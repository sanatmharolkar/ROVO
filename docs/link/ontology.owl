    <owl:Class rdf:about="https://w3id.org/rdonto/op#OnBoardDriver"/>
    


    <!-- https://w3id.org/rdonto/op#OperatingEnvironment -->


    <owl:Class rdf:about="https://w3id.org/rdonto/op#OperatingEnvironment"/>
    


