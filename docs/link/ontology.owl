    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/vocab/unit/M -->


    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/M">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#ADSCanTakeOver -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#ADSCanTakeOver">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#AvailabilityCondition"/>
        <rdfs:comment xml:lang="en">LK-10. All three must be stated: a value that is absent is not known and does not meet the condition.</rdfs:comment>
        <rdfs:label xml:lang="en">ADS can take over</rdfs:label>
        <skos:definition xml:lang="en">The session&apos;s vehicle has an ADS (RDOnto-op:hasADS true) that is within its ODD (RDOnto-link:adsWithinODD true) and able to drive now (RDOnto-link:adsAbleToDrive true).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#ActuatorLatency -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#ActuatorLatency">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#LatencyPart"/>
        <terms:source>GF20</terms:source>
        <rdfs:comment xml:lang="en">LK-03, SA-10, SA-24.</rdfs:comment>
        <rdfs:label xml:lang="en">actuator latency</rdfs:label>
        <skos:definition xml:lang="en">From the operator&apos;s command at the station to the actuator response in the vehicle.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#AvailableDataRate -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#AvailableDataRate">
        <rdf:type rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <terms:source>FE26</terms:source>
        <terms:source>NE19b</terms:source>
        <terms:source>SH21</terms:source>
        <rdfs:comment xml:lang="en">LK-06. Streams of one direction share the link, so the rates of a session&apos;s video streams are summed and the sum is compared with the required rates; a prediction gives that sum directly (DataRatePrediction). Observed with a sosa:Observation: sosa:hasFeatureOfInterest the stream, sosa:observedProperty this individual, sosa:hasSimpleResult the value in Mbit/s as a number, sosa:resultTime the time. A rate measured on the network side is an input, not network internals.</rdfs:comment>
        <rdfs:label xml:lang="en">available data rate</rdfs:label>
        <skos:definition xml:lang="en">The data rate currently available to a stream, i.e. its share of what the link carries in its direction, in Mbit/s.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#ConnectionLost -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#ConnectionLost">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Degradation"/>
        <terms:source>BR26</terms:source>
        <terms:source>KO21</terms:source>
        <rdfs:comment xml:lang="en">LK-07, LK-10. The exact rule is on ConnectionTimeout. The operator can then no longer act on the vehicle, so only adaptations that the vehicle or someone on board carries out address it.</rdfs:comment>
        <rdfs:label xml:lang="en">connection lost</rdfs:label>
        <skos:definition xml:lang="en">A stream that the current mode needs, or any stream of a session whose engagements have all ended, has delivered no data for longer than its connection timeout.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#ConnectionStateShown -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#ConnectionStateShown">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#LinkInformation"/>
        <rdfs:comment xml:lang="en">LK-11.</rdfs:comment>
        <rdfs:label xml:lang="en">connection state</rdfs:label>
        <skos:definition xml:lang="en">Whether the connection to the vehicle is up or lost.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#ContinueWithoutOperator -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#ContinueWithoutOperator">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Adaptation"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#ConnectionLost"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#ADSCanTakeOver"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#NotInRemoteDrivingMode"/>
        <preferenceRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</preferenceRank>
        <rdfs:comment xml:lang="en">LK-10. For connection loss in remote monitoring or remote assistance, where the ADS and not the operator drives. Available only if the ADS is within its ODD and able to drive (RDOnto-link:ADSCanTakeOver): in remote assistance it is not while it waits for the answer to a request. No source states it; whether a vehicle may go on without its operator is a choice of the deployment and its regulation, and a rank override can put the stop first.</rdfs:comment>
        <rdfs:label xml:lang="en">continue without operator</rdfs:label>
        <skos:definition xml:lang="en">The vehicle&apos;s ADS keeps driving within its ODD although the operator who monitors or assists it can no longer be reached.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#ControlCommands -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#ControlCommands">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#StreamContent"/>
        <contentDirection rdf:resource="https://w3id.org/rdonto/link#StationToVehicle"/>
        <neededInMode rdf:resource="https://w3id.org/rdonto/op#RemoteDriving"/>
        <isContinuous rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isContinuous>
        <terms:source>GA21b</terms:source>
        <terms:source>GA23</terms:source>
        <terms:source>NE19b</terms:source>
        <rdfs:comment xml:lang="en">LK-02. Direct Control ToD [GA21b]. NE19b: commands every 10 ms at about 0.25 Mbit/s.</rdfs:comment>
        <rdfs:label xml:lang="en">control commands</rdfs:label>
        <skos:definition xml:lang="en">The operator&apos;s driving commands (steering, throttle, brake), sent to the vehicle to be executed directly.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#DataRateInsufficient -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#DataRateInsufficient">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Degradation"/>
        <rdfs:comment xml:lang="en">LK-06, LK-10.</rdfs:comment>
        <rdfs:label xml:lang="en">data rate insufficient</rdfs:label>
        <skos:definition xml:lang="en">The data rate available from the vehicle to the station is, or is predicted to be, below what the needed camera views require.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#DeadlineMissShare -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#DeadlineMissShare">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#StatisticKind"/>
        <terms:source>FE26</terms:source>
        <rdfs:comment xml:lang="en">LK-05. A decimal between 0 and 1 [FE26].</rdfs:comment>
        <rdfs:label xml:lang="en">deadline miss share</rdfs:label>
        <skos:definition xml:lang="en">The share of the frames or commands of a stream, sent within the window, that arrived after their delivery deadline.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#EndToEndLatency -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#EndToEndLatency">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#LatencyPart"/>
        <terms:source>GF20</terms:source>
        <rdfs:comment xml:lang="en">LK-03, LK-04, LK-09.</rdfs:comment>
        <rdfs:label xml:lang="en">end-to-end latency</rdfs:label>
        <skos:definition xml:lang="en">Sensor latency plus actuator latency, without the operator&apos;s reaction time.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#HandBackToADS -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#HandBackToADS">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Adaptation"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#ConnectionLost"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#DataRateInsufficient"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyOverBudget"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyUnstable"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#ADSCanTakeOver"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#InRemoteDrivingMode"/>
        <preferenceRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</preferenceRank>
        <terms:source>BR26</terms:source>
        <terms:source>GA23</terms:source>
        <rdfs:comment xml:lang="en">LK-10. Available only if the vehicle has an ADS that is within its ODD [BR26] and able to drive (RDOnto-link:ADSCanTakeOver): not, e.g., while the failure that made it ask for the takeover lasts.</rdfs:comment>
        <rdfs:label xml:lang="en">hand back to ADS</rdfs:label>
        <skos:definition xml:lang="en">Returning the DDT to the vehicle&apos;s ADS and ending remote driving.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#HandBackToOnBoardDriver -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#HandBackToOnBoardDriver">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Adaptation"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#ConnectionLost"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#DataRateInsufficient"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyOverBudget"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyUnstable"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#OnBoardDriverCanTakeOver"/>
        <preferenceRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</preferenceRank>
        <rdfs:comment xml:lang="en">LK-10. Available only if the open engagement of the session took over from an on-board driver (RDOnto-op:takenOverFrom) who is able to take control back (RDOnto-op:ableToTakeOver true): event-based remote driving, with or without an ADS.</rdfs:comment>
        <rdfs:label xml:lang="en">hand back to on-board driver</rdfs:label>
        <skos:definition xml:lang="en">Returning the DDT to the on-board driver from whom the operator took over.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#InRemoteDrivingMode -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#InRemoteDrivingMode">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#AvailabilityCondition"/>
        <rdfs:comment xml:lang="en">LK-10. Required by the adaptations the operator carries out as the driver, or that end remote driving.</rdfs:comment>
        <rdfs:label xml:lang="en">in a remote driving mode</rdfs:label>
        <skos:definition xml:lang="en">The open engagement of the session is in a mode with RDOnto-op:isRemoteDrivingMode true.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#LatencyLevelShown -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#LatencyLevelShown">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#LinkInformation"/>
        <terms:source>NE19</terms:source>
        <rdfs:comment xml:lang="en">LK-11. NE19 showed operators the level as none, low, medium or high.</rdfs:comment>
        <rdfs:label xml:lang="en">current latency level</rdfs:label>
        <skos:definition xml:lang="en">The current level of the latency, e.g. as a value or as a class such as low, medium or high.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#LatencyOverBudget -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#LatencyOverBudget">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Degradation"/>
        <rdfs:comment xml:lang="en">LK-04, LK-08, LK-10. The result of the check described on LatencyBudget and TravelTolerance, for the measured or a predicted latency.</rdfs:comment>
        <rdfs:label xml:lang="en">latency over budget</rdfs:label>
        <skos:definition xml:lang="en">The end-to-end latency, or a part of it, is or is predicted to be above what is acceptable for the setup, mode and speed.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#LatencyUnstable -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#LatencyUnstable">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Degradation"/>
        <rdfs:comment xml:lang="en">LK-05, LK-10. The rule is on LatencyVariationLimit.</rdfs:comment>
        <rdfs:label xml:lang="en">latency unstable</rdfs:label>
        <skos:definition xml:lang="en">The standard deviation of a latency part is above the latency variation limit for the mode, even where the mean latency is within budget.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#Mean -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#Mean">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#StatisticKind"/>
        <rdfs:comment xml:lang="en">LK-05. A duration; says which latency part it covers (sosa:observedProperty).</rdfs:comment>
        <rdfs:label xml:lang="en">mean</rdfs:label>
        <skos:definition xml:lang="en">The arithmetic mean of the values of a latency part over the window.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#MinimumVideoRateAvailable -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#MinimumVideoRateAvailable">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#AvailabilityCondition"/>
        <rdfs:comment xml:lang="en">LK-06, LK-10.</rdfs:comment>
        <rdfs:label xml:lang="en">minimum video rate available</rdfs:label>
        <skos:definition xml:lang="en">The available data rate from the vehicle to the station is at least the sum of the minimumDataRate of the camera views needed in the current mode, so lowering the video quality can help; views without that value count with their requiredDataRate.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#NotInRemoteDrivingMode -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#NotInRemoteDrivingMode">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#AvailabilityCondition"/>
        <rdfs:comment xml:lang="en">LK-10. Does not hold for a session without an open engagement.</rdfs:comment>
        <rdfs:label xml:lang="en">not in a remote driving mode</rdfs:label>
        <skos:definition xml:lang="en">The open engagement of the session is in a mode with RDOnto-op:isRemoteDrivingMode false: remote monitoring or remote assistance.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#OnBoardDriverCanTakeOver -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#OnBoardDriverCanTakeOver">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#AvailabilityCondition"/>
        <rdfs:comment xml:lang="en">LK-10. A driver who does not state ableToTakeOver does not meet the condition.</rdfs:comment>
        <rdfs:label xml:lang="en">on-board driver can take over</rdfs:label>
        <skos:definition xml:lang="en">The open engagement of the session took over from an on-board driver (RDOnto-op:takenOverFrom) who is able to take control back now (RDOnto-op:ableToTakeOver true).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#PredictedDegradationShown -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#PredictedDegradationShown">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#LinkInformation"/>
        <terms:source>GA23</terms:source>
        <rdfs:comment xml:lang="en">LK-11. GA23: the remote driver is notified of predicted QoS changes.</rdfs:comment>
        <rdfs:label xml:lang="en">predicted degradation</rdfs:label>
        <skos:definition xml:lang="en">A warning that the link is predicted to degrade, shown before it does.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#ProposedTrajectory -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#ProposedTrajectory">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#StreamContent"/>
        <contentDirection rdf:resource="https://w3id.org/rdonto/link#VehicleToStation"/>
        <neededInMode rdf:resource="https://w3id.org/rdonto/op#RemoteAssistance"/>
        <isContinuous rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isContinuous>
        <terms:source>BR26</terms:source>
        <rdfs:comment xml:lang="en">LK-02. The direction opposite to Trajectory. BR26: in remote assistance the ADS can give &apos;maneuver options to the technical supervisor&apos;, and &apos;the main reason for providing these trajectories to the operator is to enable supervision and stopping of the vehicle&apos;. Kept apart from Trajectory so that a stream&apos;s content fixes its direction (contentDirection).</rdfs:comment>
        <rdfs:label xml:lang="en">proposed trajectory</rdfs:label>
        <skos:definition xml:lang="en">A route, path or trajectory that the vehicle&apos;s automation proposes, sent to the station for the operator to approve, reject or change.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#ReduceSpeed -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#ReduceSpeed">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Adaptation"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#DataRateInsufficient"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyOverBudget"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyUnstable"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#InRemoteDrivingMode"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#SpeedAboveMinimum"/>
        <preferenceRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</preferenceRank>
        <terms:source>GA21b</terms:source>
        <terms:source>JI25</terms:source>
        <terms:source>KO21</terms:source>
        <terms:source>NE19b</terms:source>
        <terms:source>SC22</terms:source>
        <rdfs:comment xml:lang="en">LK-09, LK-10. Higher latency calls for lower speed [JI25]; GA21b: above budget the vehicle &apos;must reduce the maximum speed of 8 km/h or fully stop&apos; (one scenario); NE19b, KO21 and SC22 name a lower speed as an adaptation.</rdfs:comment>
        <rdfs:label xml:lang="en">reduce speed</rdfs:label>
        <skos:definition xml:lang="en">The operator driving more slowly, so that the vehicle travels less far during the latency.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#ReduceVideoQuality -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#ReduceVideoQuality">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Adaptation"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#DataRateInsufficient"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyOverBudget"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyUnstable"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#MinimumVideoRateAvailable"/>
        <preferenceRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</preferenceRank>
        <terms:source>NE19b</terms:source>
        <terms:source>SH21</terms:source>
        <rdfs:comment xml:lang="en">LK-10. NE19b names lower resolution, switched-off cameras and a lower frame rate as mitigations; SH21 adapts bitrate and resolution per camera to the predicted available rate.</rdfs:comment>
        <rdfs:label xml:lang="en">reduce video quality</rdfs:label>
        <skos:definition xml:lang="en">Lowering the resolution, frame rate or bitrate of the video, or switching off camera views, so that the video needs less data rate.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#Reroute -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#Reroute">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Adaptation"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#DataRateInsufficient"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyOverBudget"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyUnstable"/>
        <preferenceRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</preferenceRank>
        <terms:source>NE19b</terms:source>
        <terms:source>SC22</terms:source>
        <rdfs:comment xml:lang="en">LK-10. SC22: with insufficient data rate, &apos;alternative routes can be chosen, or the velocity adapted&apos;; NE19b names route planning. Whether an alternative route exists is known to the route module.</rdfs:comment>
        <rdfs:label xml:lang="en">reroute</rdfs:label>
        <skos:definition xml:lang="en">Changing the planned route to one with better expected link quality.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#SafeStop -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#SafeStop">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Adaptation"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#ConnectionLost"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#DataRateInsufficient"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyOverBudget"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyUnstable"/>
        <preferenceRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</preferenceRank>
        <terms:source>BR26</terms:source>
        <terms:source>GA21b</terms:source>
        <terms:source>KO21</terms:source>
        <rdfs:comment xml:lang="en">LK-07, LK-10. The last resort, with no availability condition: KO21, &apos;performing a safe stop maneuver in case of communication loss needs to be possible at all time&apos;. With the connection lost the vehicle performs it on its own (MinimalRiskManoeuvre); BR26 proposes a dedicated system for it.</rdfs:comment>
        <rdfs:label xml:lang="en">safe stop</rdfs:label>
        <skos:definition xml:lang="en">Bringing the vehicle to a stop in a minimal risk condition, by a minimal risk manoeuvre.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#SensorFeed -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#SensorFeed">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#StreamContent"/>
        <contentDirection rdf:resource="https://w3id.org/rdonto/link#VehicleToStation"/>
        <isContinuous rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isContinuous>
        <terms:source>GA23</terms:source>
        <rdfs:comment xml:lang="en">LK-02. GA23 lists sensor data next to video in the direction from the vehicle.</rdfs:comment>
        <rdfs:label xml:lang="en">sensor feed</rdfs:label>
        <skos:definition xml:lang="en">Data from the vehicle&apos;s other sensors or from its perception, such as lidar points or detected objects, sent to the station.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#SensorLatency -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#SensorLatency">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#LatencyPart"/>
        <terms:source>GF20</terms:source>
        <rdfs:comment xml:lang="en">LK-03, LK-12.</rdfs:comment>
        <rdfs:label xml:lang="en">sensor latency</rdfs:label>
        <skos:definition xml:lang="en">From an event in front of the vehicle&apos;s sensors to its display at the station (glass-to-glass). The same quantity as RDOnto-op information age.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#SpeedAboveMinimum -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#SpeedAboveMinimum">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#AvailabilityCondition"/>
        <rdfs:comment xml:lang="en">LK-10.</rdfs:comment>
        <rdfs:label xml:lang="en">speed above the minimum driving speed</rdfs:label>
        <skos:definition xml:lang="en">The vehicle&apos;s current speed is above the minimumDrivingSpeed of the session&apos;s setup; a setup without that value always meets the condition.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#StandardDeviation -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#StandardDeviation">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#StatisticKind"/>
        <terms:source>NE19b</terms:source>
        <rdfs:comment xml:lang="en">LK-05, LK-10. Latency variation; NE19b uses jitter as the variation of latency.</rdfs:comment>
        <rdfs:label xml:lang="en">standard deviation</rdfs:label>
        <skos:definition xml:lang="en">The standard deviation of the values of a latency part over the window, as a measure of how much the latency varies.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#StationToVehicle -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#StationToVehicle">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Direction"/>
        <terms:source>FE26</terms:source>
        <terms:source>GA23</terms:source>
        <terms:source>MA25</terms:source>
        <rdfs:comment xml:lang="en">LK-02. Network sources call this direction downlink [GA23, FE26], while MA25 calls it uplink, so neither word is used.</rdfs:comment>
        <rdfs:label xml:lang="en">station to vehicle</rdfs:label>
        <skos:definition xml:lang="en">From the remote station to the vehicle: the direction of what the operator commands or provides.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#SwitchToRemoteAssistance -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#SwitchToRemoteAssistance">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Adaptation"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#DataRateInsufficient"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyOverBudget"/>
        <addresses rdf:resource="https://w3id.org/rdonto/link#LatencyUnstable"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#ADSCanTakeOver"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#InRemoteDrivingMode"/>
        <requiresCondition rdf:resource="https://w3id.org/rdonto/link#VehicleSupportsRemoteAssistance"/>
        <preferenceRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</preferenceRank>
        <terms:source>BR26</terms:source>
        <rdfs:comment xml:lang="en">LK-10. Available only if the vehicle supports RDOnto-op:RemoteAssistance and its ADS is within its ODD and able to drive (RDOnto-link:ADSCanTakeOver): remote assistance is advice to an ADS-equipped vehicle that is within its ODD (RDOnto-op:RemoteAssistance), and in event-based remote driving the ADS has often left its ODD [BR26].</rdfs:comment>
        <rdfs:label xml:lang="en">switch to remote assistance</rdfs:label>
        <skos:definition xml:lang="en">Ending remote driving and continuing in remote assistance, in which the ADS drives and the operator only advises.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#Trajectory -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#Trajectory">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#StreamContent"/>
        <contentDirection rdf:resource="https://w3id.org/rdonto/link#StationToVehicle"/>
        <neededInMode rdf:resource="https://w3id.org/rdonto/op#RemoteAssistance"/>
        <isContinuous rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isContinuous>
        <terms:source>GA21b</terms:source>
        <rdfs:comment xml:lang="en">LK-02. Indirect Control ToD: the vehicle performs the DDT &apos;following the route and/or pathway information provided by the ToD operator&apos; [GA21b].</rdfs:comment>
        <rdfs:label xml:lang="en">trajectory</rdfs:label>
        <skos:definition xml:lang="en">A route, path or trajectory that the operator provides or authorizes, sent to the vehicle for its automation to follow.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#VehicleSpeed -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#VehicleSpeed">
        <rdf:type rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">LK-04, LK-08, LK-09, LK-10. Interface (vehicle state, VSS Vehicle.Speed). Observed with sosa:hasFeatureOfInterest the vehicle and sosa:hasSimpleResult in km/h.</rdfs:comment>
        <rdfs:label xml:lang="en">vehicle speed</rdfs:label>
        <skos:definition xml:lang="en">The speed at which a vehicle is currently moving, in km/h.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#VehicleSupportsRemoteAssistance -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#VehicleSupportsRemoteAssistance">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#AvailabilityCondition"/>
        <rdfs:comment xml:lang="en">LK-10.</rdfs:comment>
        <rdfs:label xml:lang="en">vehicle supports remote assistance</rdfs:label>
        <skos:definition xml:lang="en">The session&apos;s vehicle has RDOnto-op:supportsMode RDOnto-op:RemoteAssistance.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#VehicleToStation -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#VehicleToStation">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#Direction"/>
        <terms:source>FE26</terms:source>
        <terms:source>GA23</terms:source>
        <terms:source>MA25</terms:source>
        <rdfs:comment xml:lang="en">LK-02. Network sources call this direction uplink [GA23, FE26], while MA25 calls it downlink, so neither word is used.</rdfs:comment>
        <rdfs:label xml:lang="en">vehicle to station</rdfs:label>
        <skos:definition xml:lang="en">From the vehicle to the remote station: the direction of what the vehicle senses and reports.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/link#VideoFeed -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/link#VideoFeed">
        <rdf:type rdf:resource="https://w3id.org/rdonto/link#StreamContent"/>
        <contentDirection rdf:resource="https://w3id.org/rdonto/link#VehicleToStation"/>
        <neededInMode rdf:resource="https://w3id.org/rdonto/op#RemoteAssistance"/>
        <neededInMode rdf:resource="https://w3id.org/rdonto/op#RemoteDriving"/>
        <neededInMode rdf:resource="https://w3id.org/rdonto/op#RemoteMonitoring"/>
        <isContinuous rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isContinuous>
        <terms:source>GA23</terms:source>
        <terms:source>NE19b</terms:source>
        <rdfs:comment xml:lang="en">LK-02, LK-06. NE19b: at least 3 Mbit/s from the vehicle for video.</rdfs:comment>
        <rdfs:label xml:lang="en">video feed</rdfs:label>
        <skos:definition xml:lang="en">Camera images from the vehicle, sent to the station to be displayed to the operator.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/rdonto/op#RemoteAssistance -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/op#RemoteAssistance"/>
    


    <!-- https://w3id.org/rdonto/op#RemoteDriving -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/op#RemoteDriving"/>
    


    <!-- https://w3id.org/rdonto/op#RemoteMonitoring -->


    <owl:NamedIndividual rdf:about="https://w3id.org/rdonto/op#RemoteMonitoring"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="https://w3id.org/rdonto/link#predictedValue">
        <rdfs:comment xml:lang="en">LK-08, LK-09. Compared with the limits as a measured latency is; with it, LK-09 gives the admissible speed for the predicted latency.</rdfs:comment>
        <rdfs:label xml:lang="en">predicted value</rdfs:label>
        <skos:definition xml:lang="en">The latency expected over the window of a latency prediction, as a duration.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rdonto/link#sessionVehicle">
        <rdfs:comment xml:lang="en">LK-01. A session has exactly one, and a vehicle has at most one open session at a time (RDOnto-link-shapes.ttl).</rdfs:comment>
        <rdfs:label xml:lang="en">session vehicle</rdfs:label>
        <skos:definition xml:lang="en">The vehicle that a teleoperation session connects to the remote station.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rdonto/link#setupVehicle">
        <rdfs:comment xml:lang="en">LK-04. A setup can name several, e.g. a fleet of one model. A session that uses the setup must have one of them as its vehicle, where the setup names any (RDOnto-link-shapes.ttl).</rdfs:comment>
        <rdfs:label xml:lang="en">setup vehicle</rdfs:label>
        <skos:definition xml:lang="en">A vehicle that the limits of a teleoperation setup were configured for.</skos:definition>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#Adaptation"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#AdaptationRankOverride"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#AvailabilityCondition"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#Degradation"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#Direction"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#LatencyObservation"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#LatencyPart"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#LatencyStatistic"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#LinkInformation"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#LinkPrediction"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#MinimalRiskManoeuvre"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#MinimalRiskManoeuvreKind"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#RemoteStation"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#StatisticKind"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#Stream"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#StreamContent"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#TeleoperationSession"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/link#TeleoperationSetup"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#ConfiguredLimit"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#Cue"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#DisplayedScene"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#DrivingTask"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#ElementStateChange"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#Engagement"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#FallbackReadyPeriod"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#Impairment"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#ImpairmentObservation"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#InformationChannel"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#OnBoardDriver"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#OperatingEnvironment"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#OperationMode"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#OperatorTask"/>
            <rdf:Description rdf:about="https://w3id.org/rdonto/op#PerceptionAssertion"/>
