    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="http://purl.org/dc/terms/created">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/dc/terms/description">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/dc/terms/license">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/dc/terms/modified">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rovo/op#CueInterpretationTask">
        <terms:source>AM22</terms:source>
        <rdfs:comment xml:lang="en">SA-02, remote assistance. AM22&apos;s example of a remote assistant performing an OEDR-like action without performing the DDT.</rdfs:comment>
        <rdfs:label xml:lang="en">cue interpretation task</rdfs:label>
        <skos:definition xml:lang="en">Interpreting what the vehicle cannot, e.g. identifying an object in the lane as an empty bag that can be driven through.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rovo/op#DecisionMakingTask">
        <terms:source>AM22</terms:source>
        <rdfs:comment xml:lang="en">SA-02, remote assistance. AM22: the remote assistant provides a new pathway around road construction, which the ADS executes.</rdfs:comment>
        <rdfs:label xml:lang="en">decision-making task</rdfs:label>
        <skos:definition xml:lang="en">Deciding on and authorizing an option for the vehicle, e.g. a path, a waypoint or a go-ahead, which the ADS then executes.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rovo/op#ObservationTask">
        <terms:source>AM22</terms:source>
        <rdfs:comment xml:lang="en">SA-02, remote monitoring.</rdfs:comment>
        <rdfs:label xml:lang="en">observation task</rdfs:label>
        <skos:definition xml:lang="en">Observing the vehicle and its situation without influencing the DDT.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rovo/op#adaptedInformationAge">
        <terms:source>HA24</terms:source>
        <terms:source>NE19</terms:source>
        <rdfs:comment xml:lang="en">SA-14. Interface (stream layer, fed by ROVO-link LK-05). HA24: latency adaptation took from 1-2 drives to months; NE19 varied latency within a drive. Adaptation belongs to the operator and the setup, not to one engagement, so a new engagement need not start it again: an engagement with adaptationCarriedFrom states no value of its own, and the value that applies to it is that of the engagement it is carried from, followed back to the one that measured it (ROVO-op-shapes.ttl).</rdfs:comment>
        <rdfs:label xml:lang="en">adapted information age</rdfs:label>
        <skos:definition xml:lang="en">The information age the operator is adapted to, as measured in this engagement, e.g. as the median over its first minutes.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/rovo/op#captureDelay">
        <terms:source>GF20</terms:source>
        <rdfs:comment xml:lang="en">SA-08, SA-09. Configuration or offline measurement, not a per-frame value; GF20 measured roughly 15-35 ms. With it, information age runs from the event to its display, GF20&apos;s sensor (glass-to-glass) latency. A sensor without a value counts as zero delay. Shared with ROVO-link.</rdfs:comment>
        <rdfs:label xml:lang="en">capture delay</rdfs:label>
        <skos:definition xml:lang="en">The time from an event in front of the sensor to the frame that shows it being captured: exposure, readout and transfer to the vehicle computer.</skos:definition>
    </rdf:Description>
    


